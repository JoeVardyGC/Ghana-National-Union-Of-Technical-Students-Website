# ===================================================
# GNUTS Production Deployment Environment Configuration
# ===================================================

# 1. Application URL
NEXT_PUBLIC_APP_URL=https://gnuts.org.gh

# 2. Database Connection (MySQL / MariaDB)
# You can provide either DATABASE_URL or individual DB parameters:
DATABASE_URL=mysql://root:password@127.0.0.1:3306/gnuts

# Individual Database Parameters (Alternative to DATABASE_URL):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gnuts
DB_SSL=false

# 3. Media & Document CDN Storage (ImageKit.io - Recommended Free Tier)
# Get free keys from https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# 4. Optional: Legacy Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

