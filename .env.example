# ===================================================
# GNUTS Production Deployment Environment Configuration
# ===================================================

# 1. Application URL
NEXT_PUBLIC_APP_URL=https://gnuts.org

# 2. Database Connection (MySQL / MariaDB)
# You can provide either DATABASE_URL or individual DB parameters:
DATABASE_URL=mysql://root:password@127.0.0.1:3306/gnuts

# Individual Database Parameters (Alternative to DATABASE_URL):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gnuts
DB_SSL=false

# 3. Admin Authentication (REQUIRED in production)
# Random secret (32+ chars) used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# First Super Admin, created by POST /api/admin/init-db when the users table is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# One-time setup token for POST /api/admin/init-db before any admin exists (send as "x-init-token" header).
INIT_DB_TOKEN=

# 4. Media & Document CDN Storage (ImageKit.io - Recommended Free Tier)
# Get free keys from https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# 5. Contact Form Email Alerts (Resend - https://resend.com/api-keys)
# Leave RESEND_API_KEY empty to disable alerts (messages are still saved to the database).
RESEND_API_KEY=
# Who receives the alert. Separate several addresses with commas.
CONTACT_NOTIFY_EMAIL=info@gnuts.org.gh
# Sender. The domain must be verified in Resend (https://resend.com/domains).
CONTACT_FROM_EMAIL=GNUTS Website <noreply@gnuts.org.gh>

# 6. Optional: Legacy Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

